#!/usr/bin/env bash
#
# progfun-test — compile a C file into a temp dir, run it, clean up
#
# Usage: progfun-test <path/to/program.c> [args passed to the program...]

set -uo pipefail

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: progfun-test <path/to/program.c> [program args...]" >&2
    exit 1
fi

SRC="$1"
shift

[[ -f "$SRC" ]] || { echo "progfun-test: no such file: $SRC" >&2; exit 1; }

BUILD_DIR="${TMPDIR:-/tmp}/progfun-test"
mkdir -p "$BUILD_DIR" || exit 1

BIN="$(mktemp "$BUILD_DIR/$(basename -- "${SRC%.c}").XXXXXX")" || exit 1

cleanup() { rm -f -- "$BIN"; }
trap cleanup EXIT

gcc -std=c99 -Wall -pedantic -o "$BIN" "$SRC" -lm || exit $?

"$BIN" "$@"
exit $?
